# Copy to .env and fill in. .env is git-ignored.

# Sent in the User-Agent header of every request to public services, so their
# operators can reach you instead of blocking you. An email address or a URL.
# Required by every command that touches the network.
GLAUX_CONTACT=

GLAUX_DATABASE_URL=postgresql://glaux:glaux@127.0.0.1:5432/glaux
GLAUX_DATA_DIR=./data

# Seconds to wait between requests to the same service.
GLAUX_REQUEST_DELAY=1.0
